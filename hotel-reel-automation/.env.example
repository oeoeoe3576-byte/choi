# hotel-reel-automation 환경변수 예시
# 이 파일을 .env로 복사한 뒤 값을 채우세요: cp .env.example .env
# .env는 python-dotenv로 자동 로드되지 않으므로, 쉘에서 export 하거나
# `set -a; source .env; set +a` 로 로드한 뒤 실행하세요.

# ---- LLM (선택) ----
# 설정하면 대본/캡션 생성이 실제 Claude 호출로 업그레이드된다.
# 없으면 규칙 기반 템플릿으로 오프라인 동작한다 (기본값, 100% 동작 보장).
ANTHROPIC_API_KEY=

# 사용할 모델 (기본값: claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5

# ---- 스토리지 (2차 확장 포인트) ----
# 현재는 로컬 파일시스템만 지원한다 (src/adapters/storage_adapter.py).
# STORAGE_PROVIDER=local

# ---- Image-to-Video (2차 확장 포인트) ----
# 현재는 stub만 존재한다 (src/adapters/image_to_video_adapter.py).
# IMAGE_TO_VIDEO_PROVIDER=
# IMAGE_TO_VIDEO_API_KEY=
